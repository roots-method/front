.DS_Store
**/.DS_Store

# Installers and disk images — a stray download here can exceed GitHub's
# 100 MB file limit and is painful to remove once committed.
*.dmg
*.pkg
*.zip

# Generated collateral. The brochure is a build artifact rebuilt from the
# generator script, not a source file; it changes wholesale on every edit.
assets/Arka-Brochure*.pdf

# Unreferenced working assets
assets/tools-banner-tp.png

# Next.js
/.next/
/out/
/build
node_modules/
.vercel
*.tsbuildinfo
next-env.d.ts

# The pre-React vanilla site, kept locally as the porting reference.
# Untracked on purpose (git rm -r --cached legacy/) — it is a local artefact,
# not part of the deployed app. It still exists in history before that commit
# if it is ever needed again.
legacy/
